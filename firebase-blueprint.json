{
  "entities": {
    "UserProfile": {
      "description": "Authenticated user profiles (Google or GitHub)",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "provider": { "type": "string", "maxLength": 32 },
        "lastLogin": { "type": "timestamp" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["uid", "email", "provider"]
    },
    "ContactMessage": {
      "description": "Messages sent via the portfolio contact form",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "senderUid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "message": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["id", "senderUid", "name", "email", "message"]
    },
    "OsintQuery": {
      "description": "Saved OSINT workbench search history or logs",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "query": { "type": "string", "maxLength": 256 },
        "targetType": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "timestamp" }
      },
      "required": ["id", "userId", "query"]
    }
  },
  "firestore": {
    "paths": {
      "users/{userId}": {
        "schema": "UserProfile",
        "description": "User profile document per uid"
      },
      "contactMessages/{messageId}": {
        "schema": "ContactMessage",
        "description": "Contact messages submitted by portfolio visitors"
      },
      "osintQueries/{queryId}": {
        "schema": "OsintQuery",
        "description": "OSINT queries executed by authenticated users"
      }
    }
  }
}
