rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for authentication check
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /contactMessages/{messageId} {
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || request.auth.token.email == 'progroup@atomicmail.io');
    }

    match /osintQueries/{queryId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
